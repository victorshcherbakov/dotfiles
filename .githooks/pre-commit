#!/bin/sh
# Refuse a commit that stages personal or employer-specific data. This repo is
# public: a pushed line stays reachable by SHA even after a force-push, so the
# check has to happen before the commit exists.
#
# Only the lines a commit ADDS are scanned. Generic patterns (private keys, API
# tokens, email addresses, RFC1918 hosts) live here. Site-specific strings - an
# employer domain, an internal host, an issue-tracker prefix - belong in
# $GIT_DIR/secret-patterns, which git never tracks, so this public file does not
# spell out the very words it exists to hide. `make install-private` links it to
# the private dotfiles directory; without it the commit is refused, because a
# half-checked commit reads as a checked one. Format there: one extended regex
# per line, optionally "<regex><TAB><label>"; blank lines and # comments ignored.
# Those are POSIX EREs as awk understands them - `\b` is not a word boundary
# there; write `(^|[^A-Za-z0-9])word($|[^A-Za-z0-9])` when a boundary matters.
#
# `git commit --no-verify` skips the check when a hit is a false positive.

set -u

diff=$(git diff --cached -U0 --diff-filter=ACMR 2>/dev/null) || exit 0
[ -n "$diff" ] || exit 0

site=$(git rev-parse --git-path secret-patterns 2>/dev/null) || site=""
if [ -z "$site" ] || [ ! -r "$site" ]; then
	cat >&2 <<'EOF'

pre-commit: the site-specific blocklist is missing ($GIT_DIR/secret-patterns,
normally a symlink into the private dotfiles directory). Only generic patterns
would be checked, so this commit is refused rather than half-checked.
Run `make install-private`, or `git commit --no-verify` to commit anyway.
EOF
	exit 1
fi

printf '%s\n' "$diff" | awk -v site="$site" '
function add(re, label) { n++; pat[n] = re; desc[n] = label }

# Placeholders and no-reply addresses are documentation, not a leak.
function allowed(frag) {
    return frag ~ /example\.(com|org|net)|noreply@|your_email@|user@host|@localhost/
}

BEGIN {
    n = 0
    add("-----BEGIN [A-Z ]*PRIVATE KEY", "private key")
    add("gh[pousr]_[A-Za-z0-9]{20,}", "GitHub token")
    add("xox[baprs]-[A-Za-z0-9-]{10,}", "Slack token")
    add("AKIA[0-9A-Z]{16}", "AWS access key id")
    add("[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}", "email address")
    # Full dotted quad with non-numeric edges, so a version like 10.2.1 is not an address.
    add("(^|[^0-9.])(10(\\.[0-9]{1,3}){3}|192\\.168(\\.[0-9]{1,3}){2}|172\\.(1[6-9]|2[0-9]|3[01])(\\.[0-9]{1,3}){2})($|[^0-9.])", "private IP")

    while ((getline line < site) > 0) {
        if (line ~ /^[ \t]*$/ || line ~ /^[ \t]*#/) continue
        tab = index(line, "\t")
        if (tab) add(substr(line, 1, tab - 1), substr(line, tab + 1))
        else add(line, "site-specific pattern")
    }
}

/^\+\+\+ /  { file = substr($0, 7); next }          # "+++ b/<path>"
/^@@/       { match($0, /\+[0-9]+/)                  # "@@ -a,b +c,d @@" -> c
              lineno = substr($0, RSTART + 1, RLENGTH - 1) + 0
              next }
/^\+/ {
    text = substr($0, 2)
    for (i = 1; i <= n; i++) {
        if (match(text, pat[i])) {
            frag = substr(text, RSTART, RLENGTH)
            if (allowed(frag)) continue
            printf "  %s:%d  %s\n    %s\n", file, lineno, desc[i], frag > "/dev/stderr"
            found = 1
            break
        }
    }
    lineno++
}

END { exit (found ? 1 : 0) }
' && exit 0

cat >&2 <<'EOF'

pre-commit: the staged changes add data this repo should not publish (above).
Remove it, or commit with --no-verify if the match is a false positive.
EOF
exit 1
