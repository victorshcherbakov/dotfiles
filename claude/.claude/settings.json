{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/context-warn.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/dotfiles-uncommitted-warn.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cmd=$(jq -r '.tool_input.command // \"\"'); printf \"%s\" \"$cmd\" | grep -q \"git mv\" || exit 0; out=$(printf \"git mv: verify moved files show R (rename), not D+add:\\n\"; git status --short -uno; echo \"--- staged renames (diff --cached -M --diff-filter=R) ---\"; git diff --cached -M --diff-filter=R --name-status); jq -n --arg c \"$out\" '{hookSpecificOutput:{hookEventName:\"PostToolUse\",additionalContext:$c}}' ",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/hooks/statusline.py"
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true
  },
  "language": "russian",
  "effortLevel": "xhigh",
  "voice": {
    "enabled": true,
    "mode": "tap"
  },
  "theme": "dark",
  "autoCompactEnabled": false,
  "voiceEnabled": true
}
