{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/py.sh\" \"$HOME/.claude/hooks/context-warn.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/py.sh\" \"$HOME/.claude/hooks/dotfiles-uncommitted-warn.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/py.sh\" \"$HOME/.claude/hooks/git-mv-verify.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "\"$HOME/.claude/hooks/py.sh\" \"$HOME/.claude/hooks/statusline.py\""
  },
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true
  },
  "language": "russian",
  "effortLevel": "xhigh",
  "voice": {
    "enabled": true,
    "mode": "tap"
  },
  "theme": "dark",
  "autoCompactEnabled": false,
  "voiceEnabled": true,
  "permissions": {
    "allow": [
      "Bash(py:*)"
    ]
  }
}
