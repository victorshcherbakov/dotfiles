{
  "$schema": "https://www.schemastore.org/claude-code-keybindings.json",
  "$docs": "https://code.claude.com/docs/en/keybindings",
  "bindings": [
    {
      "context": "Scroll",
      "bindings": {
        "alt+k": "scroll:lineUp",
        "alt+j": "scroll:lineDown",
        "alt+l": "scroll:halfPageUp",
        "alt+h": "scroll:halfPageDown"
      }
    },
    {
      "context": "Chat",
      "bindings": {
        "enter": "chat:newline",
        "shift+enter": "chat:submit"
      }
    }
  ]
}
